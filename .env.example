# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env   затем   nano .env

# Ключ Groq для расшифровки голосовых (console.groq.com)
GROQ_API_KEY=gsk_ВСТАВЬТЕ_СЮДА_СВОЙ_КЛЮЧ

# ПИН администратора (добавление/удаление видео)
ADMIN_PIN=4829

# ПИН пользователя для входа (по умолчанию 2026, менять не обязательно)
# USER_PIN=2026

# Порт, на котором работает сайт (обычно 3000)
PORT=3000
